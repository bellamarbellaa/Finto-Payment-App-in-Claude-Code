# ---- Core ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- Database ----
# Local Postgres:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finto

# Supabase — copy from Settings -> Database -> Connection string, and replace
# [YOUR-PASSWORD] with your real database password.
#
#   Direct connection (IPv6 only — use for migrations, and locally):
#   DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
#   Session pooler (IPv4 — use when deploying somewhere without IPv6):
#   DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Do NOT use the transaction pooler on port 6543: it does not support the
# prepared statements and session-level locks this ledger relies on.

# TLS. 'auto' enables it for every host except localhost. Managed Postgres
# always needs it.
DATABASE_SSL=auto
# Optional path to a CA certificate (PEM). Without it the connection is still
# encrypted, but the server's certificate is not verified — set this before
# production. Supabase publishes its CA under Settings -> Database -> SSL.
# DATABASE_CA_CERT=./supabase-ca.crt

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- Clients ----
# Comma separated. Web origins need CORS; native mobile apps do not send an Origin header.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
# Set to your API's public origin, used to build QR / payment links
PUBLIC_BASE_URL=http://localhost:4000
# Deep link scheme for the mobile app (used in pay-by-link QR codes)
APP_LINK_SCHEME=finto

# ---- Cookies (desktop web sessions) ----
COOKIE_SECRET=replace-me-with-another-long-random-string
COOKIE_DOMAIN=
COOKIE_SECURE=false
# 'lax' while the web app and API share a domain. Set to 'none' when they are
# deployed separately (e.g. Vercel front end + Railway API), or the browser will
# refuse to send the refresh cookie and logins will not survive a reload.
# 'none' requires HTTPS on both.
COOKIE_SAMESITE=lax
